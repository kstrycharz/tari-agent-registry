{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TariTracker package manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "name", "description", "version", "license", "maintainers", "entrypoint", "files", "permissions", "network_hosts", "networks", "tags", "tari_references", "compatibility", "security_notes", "runtime", "status"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"enum": ["agent", "mcp", "skill"]},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 64},
    "name": {"type": "string", "minLength": 1, "maxLength": 100},
    "description": {"type": "string", "minLength": 1, "maxLength": 500},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$", "maxLength": 30},
    "license": {"enum": ["MIT", "Apache-2.0", "BSD-3-Clause", "ISC"]},
    "maintainers": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]{0,38}$"}},
    "entrypoint": {"type": "string", "minLength": 1, "maxLength": 150},
    "files": {"type": "array", "minItems": 3, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 150}},
    "permissions": {"type": "array", "uniqueItems": true, "maxItems": 10, "items": {"enum": ["network:read", "filesystem:read", "filesystem:write", "process:execute", "wallet:read", "wallet:sign", "wallet:spend"]}},
    "network_hosts": {"type": "array", "uniqueItems": true, "maxItems": 30, "items": {"type": "string", "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$", "maxLength": 253}},
    "networks": {"type": "array", "minItems": 1, "uniqueItems": true, "maxItems": 4, "items": {"enum": ["none", "localnet", "testnet", "mainnet"]}},
    "tags": {"type": "array", "uniqueItems": true, "maxItems": 20, "items": {"type": "string", "pattern": "^[a-z0-9-]{1,32}$"}},
    "tari_references": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "format": "uri", "pattern": "^https://(?:tari\\.com|www\\.tari\\.com|ootle\\.tari\\.com|github\\.com/tari-project)(?:/[^\\s]*)?$", "maxLength": 500}},
    "compatibility": {"type": "string", "minLength": 1, "maxLength": 500},
    "security_notes": {"type": "string", "minLength": 1, "maxLength": 1000},
    "runtime": {"enum": ["instructions", "python3"]},
    "status": {"enum": ["active", "deprecated"]}
  }
}
